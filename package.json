{
    "name": "com.contax.warehouseAnalytics",
    "scripts": {
        "build": "mbt build --mtar com.contax.warehouseAnalytics.mtar",
        "build:workspaces": "npm run build --workspaces --if-present",
        "deploy": "cf deploy mta_archives/com.contax.warehouseAnalytics.mtar --retries 0",
        "lint": "npm run lint --workspaces --if-present",
        "ui5lint": "npm run ui5lint --workspaces --if-present",
        "start:myui5app": "npm start --workspace myui5app"
    },
    "dependencies": {
        "mbt": "^1"
    },
    "workspaces": [
        "myui5app"
    ]
}